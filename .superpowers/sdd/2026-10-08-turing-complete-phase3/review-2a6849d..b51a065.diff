+      const values = Object.values(step.inputs ?? {});
+      const value = values[0];
+      if (values.length !== 1 || typeof value !== 'number') {
+        throw new Error(`${spec.id} step ${step.tick} does not drive exactly one byte`);
+      }
+      return value;
+    }),
+  );
