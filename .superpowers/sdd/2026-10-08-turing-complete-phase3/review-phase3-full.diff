+    expect(failure.detail).toContain('(1,1)');
+  });
+
+  it('rejects a player who has typed nothing on the maze', () => {
+    const spec = level('ch4-56-the-maze');
+    const outcome = runChecks(boardOf(spec), registry, spec, { text: '  \n' });
