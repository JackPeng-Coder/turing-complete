+  color: var(--hot);
+  font-family: inherit;
+  font-size: 12px;
+  line-height: 1;
+  cursor: pointer;
+}
+.debug-page-prev:hover:not(:disabled), .debug-page-next:hover:not(:disabled) { border-color: var(--hot); }
+.debug-page-prev:disabled, .debug-page-next:disabled { color: var(--text-muted); border-color: var(--hair); cursor: not-allowed; }
+
+.debug-ram { padding: 4px 10px 8px; background: var(--void); font-variant-numeric: tabular-nums; }
+.debug-row { display: flex; gap: 4px; padding: 1px 0; }
+.debug-addr { flex: 0 0 2.4em; color: var(--text-muted); font-size: 11.5px; }
+.debug-byte {
+  width: 2.6em;
+  text-align: center;
+  color: var(--text);
+  font-size: 11.5px;
+}
+/* THE BYTE BEING EXECUTED. A fill rather than an outline, so it reads from a
