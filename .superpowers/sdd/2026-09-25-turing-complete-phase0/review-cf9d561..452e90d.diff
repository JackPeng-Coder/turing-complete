+
+    store.set({ progress: passedLevel1 });
+    const after = [...root.querySelectorAll<HTMLButtonElement>('.map-tile')];
+    expect(after).toHaveLength(LEVELS.length);
+    expect(after[1]!.disabled).toBe(false);
+  });
+});
