+    ]),
+  'ch1-03-not-gate': () =>
+    build([
+      { kind: 'input', name: 'a' },
+      { kind: 'part', def: 'nand', id: 'g', from: ['a', 'a'] },
+      { kind: 'output', from: 'g' },
+    ]),
+  'ch1-04-and-gate': () =>
+    build([
+      { kind: 'input', name: 'a' },
+      { kind: 'input', name: 'b' },
+      { kind: 'part', def: 'nand', id: 'g1', from: ['a', 'b'] },
+      { kind: 'part', def: 'not', id: 'g2', from: ['g1'] },
+      { kind: 'output', from: 'g2' },
+    ]),
+  'ch1-05-or-gate': () =>
+    build([
+      { kind: 'input', name: 'a' },
+      { kind: 'input', name: 'b' },
+      { kind: 'part', def: 'not', id: 'n1', from: ['a'] },
