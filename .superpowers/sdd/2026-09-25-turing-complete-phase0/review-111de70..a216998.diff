+    connect(g, { inst: one.id, port: 'out' }, { inst: n2.id, port: 'b' });
+    connect(g, { inst: n1.id, port: 'out' }, { inst: n2.id, port: 'a' });
+    connect(g, { inst: n2.id, port: 'out' }, { inst: n1.id, port: 'a' });
