+ * is the contract every port in the kernel has (a port carries 0..255 and
+ * `assertWidth` accepts nothing else).
+ */
+function signedByte(pattern: number): number {
+  const byte = pattern & 0xff;
+  return byte < 0x80 ? byte : byte - 0x100;
