+/** Level 37's reference: the 256-byte RAM, which is the whole little box. */
+function littleBoxReference(): Graph {
+  return build([
+    { kind: 'input', name: 'd', width: 8 },
+    { kind: 'input', name: 'addr', width: 8 },
