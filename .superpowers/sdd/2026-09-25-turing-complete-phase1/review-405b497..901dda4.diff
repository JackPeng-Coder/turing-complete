+const sum8 = (v: FuzzVector): number => ((v.a ?? 0) + (v.b ?? 0)) & 0xff;
+const carry8 = (v: FuzzVector): number => (((v.a ?? 0) + (v.b ?? 0)) >> 8) & 1;
