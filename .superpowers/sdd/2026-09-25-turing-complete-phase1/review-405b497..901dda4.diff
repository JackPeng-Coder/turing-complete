+ */
+const ram8: ComponentDef = {
+  id: 'ram8',
+  name: { zh: '8 位存储器', en: '8-Bit RAM' },
+  category: 'wide',
+  inputs: [
+    { id: 'd', width: W },
+    { id: 'addr', width: W },
+    { id: 'load', width: 1 },
+  ],
+  outputs: wideOut(W),
+  cost: 0,
+  sequential: true,
