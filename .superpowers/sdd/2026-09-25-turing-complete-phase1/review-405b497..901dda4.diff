+    expect(second!.steps.map((step) => step.tick)).toEqual([0, 1, 2, 3, 4, 5, 6, 7]);
+    for (const step of second!.steps) {
+      expect(driven(step, 'enable')).toBe(0);
+      expect(expectedOut(step)).toBe(0);
+    }
+  });
+});
