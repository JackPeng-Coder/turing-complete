+    { kind: 'script', steps: [{ tick: 0, expect: { out: 0 } }] },
+    {
+      kind: 'constraint',
+      rule: { kind: 'sum-equals', inputs: ['a'], output: 'out' },
+    },
+    {
+      kind: 'fuzz',
