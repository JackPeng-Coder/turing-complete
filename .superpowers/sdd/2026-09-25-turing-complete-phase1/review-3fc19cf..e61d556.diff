+  return build([
+    { kind: 'input', name: 'a', width: 8 },
+    { kind: 'input', name: 'b', width: 8 },
+    { kind: 'part', def: 'and8', id: 'and', from: ['a', 'b'] },
+    { kind: 'output', name: 'OUT_out', from: 'and.out', width: 8 },
+  ]);
