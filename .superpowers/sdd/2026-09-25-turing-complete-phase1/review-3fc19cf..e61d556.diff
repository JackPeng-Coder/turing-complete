+    const first: FuzzVector[] = [];
+    const second: FuzzVector[] = [];
+    const run = (sink: FuzzVector[]): boolean =>
+      runChecks(addCircuit(), registry, withChecks(addLevel, [capture(sink, 0x1234)])).passed;
