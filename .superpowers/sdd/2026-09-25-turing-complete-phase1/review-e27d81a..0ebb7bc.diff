+  id: string,
+  name: { zh: string; en: string },
+  w: number,
+  gateCost: number,
+  fn: (a: number, b: number, w: number) => number,
+): ComponentDef {
+  return combinational(
+    id,
+    name,
+    'wide',
+    [
+      { id: 'a', width: w },
+      { id: 'b', width: w },
+    ],
+    bitOut(),
+    1,
+    gateCost,
+    (i, o) => {
