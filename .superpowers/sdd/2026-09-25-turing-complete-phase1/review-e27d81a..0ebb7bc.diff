+    // so `createWideDefs(8)` yields the pair `switch` / `switch8` the contract
+    // asks for.
+    switchDef('switch', { zh: '开关', en: 'Switch' }, 1),
+    switchDef(`switch${w}`, { zh: `${w} 位开关`, en: `${w}-Bit Switch` }, w),
+  ];
+}
