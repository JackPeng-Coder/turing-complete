+      [1, 255, 255],
+      [16, 16, 0], // 256 wraps to 0
+      [15, 17, 255],
+      [2, 100, 200],
+      [0x10, 0x0f, 240],
+      [255, 255, 1], // 65025 & 0xff
+    ];
+    for (const [a, b, want] of cases) {
+      expect(at('mul8', a, b), `mul8(${a},${b})`).toBe(want);
+    }
+  });
