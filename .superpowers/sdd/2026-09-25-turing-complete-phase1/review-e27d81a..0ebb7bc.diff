+
+/** The inverse of `splitOp`: `makeOp(splitOp(x, w), w) === x`. */
+function makeOp(bits: readonly number[], w: number): number {
+  let out = 0;
+  for (let b = 0; b < w; b += 1) out += bit(bits[b]) << b;
+  return u(out, w);
